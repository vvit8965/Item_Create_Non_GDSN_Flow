pipeline {
    agent {
        kubernetes {
            yamlFile 'perfPlatform/Jenkins-Slave-Pod.yaml'  // path to the jenkins slave pod definition relative to the root of our project
        }
    }

    parameters {
        string(defaultValue: "httpCounterDocker", description: 'jmeter script name', name: 'ScriptName')
        string(defaultValue: "qperfmaster", description: 'Project job name', name: 'JobName')
    }

    environment {
        // JOBNAME = "qperfmaster"
        scriptName = "${params.ScriptName}"
    }

    stages {
        stage('Set Job Name') {
            steps {
                script {
                    env.JOBNAME = params.JobName.toLowerCase().replaceAll("[^a-z0-9.-]", "-")
                    echo "Scrptname: ${env.scriptName}"
                    echo "Sanitized JOBNAME: ${env.JOBNAME}"
                }
            }
        }

        stage('Deploy JMeter Slaves') {
            steps {
                container('kubehelm') {
                    sh 'echo =======================Start deploy JMeter Slaves==============='
                    sh '''
                        helm install --wait distributed-jmeter-slave-${JOBNAME}-${BUILD_NUMBER} jmeter-helm/jmeter-slave -f perfPlatform/JMeter-Slave-Pod-Values.yaml
                        kubectl wait --for=condition=ready pods -l app.kubernetes.io/instance=distributed-jmeter-slave-${JOBNAME}-${BUILD_NUMBER} --timeout=90s
                    '''
                    script {
                        env.jmeterSlaveNodesIPList = sh(returnStdout: true, script: '''
                            kubectl get pods -l app.kubernetes.io/instance=distributed-jmeter-slave-${JOBNAME}-${BUILD_NUMBER} -o jsonpath='{.items[*].status.podIP}' | tr ' ' ','
                        ''').trim()
                        println("IP Details: ${env.jmeterSlaveNodesIPList}")
                    }
                    sh 'echo =======================Finishing deploy JMeter Slaves==============='
                }
            }
        }

        stage('Copying test data files to JMeter Slaves') {
            steps {
                container('kubehelm') {
                    sh 'echo ===============Start copying data files======================='
                    sh 'pwd'
                    sh '''
                        for pod in $(kubectl get pod -l app.kubernetes.io/instance=distributed-jmeter-slave-${JOBNAME}-${BUILD_NUMBER} -o custom-columns=:metadata.name); do
                            kubectl cp src/test/testdata/ $pod:/opt/perf-test-data/
                        done
                    '''
                    sh 'echo ===============Finishing copying data files======================='
                }
            }
        }

        stage('Execute Performance Test') {
            steps {
                container('distributed-jmeter-master') {
                    sh 'echo ===============Start maven build execution======================='
                    sh '''
                        echo ${jmeterSlaveNodesIPList}
                        mvn clean install -DjmeterSlaveNodesIPList=${jmeterSlaveNodesIPList} -DscriptName=${scriptName} -DbuildNo=${BUILD_NUMBER}
                    '''
                    sh 'echo ===============Finishing maven build execution======================='
                }
            }
        }

        stage('Read Performance Test Results') {
            steps {
                container('distributed-jmeter-master') {
                    sh 'echo ===============Start read Performance Test Results======================='
                    sh 'pwd'

                    // Add directory creation and copy check
                    sh '''
                        mkdir -p /var/jenkins_home/jobs/${JOB_NAME}/builds/${BUILD_NUMBER}/temp/target/jmeter/results/
                        if ls target/jmeter/results/*.csv 1> /dev/null 2>&1; then
                            cp target/jmeter/results/*.csv /var/jenkins_home/jobs/${JOB_NAME}/builds/${BUILD_NUMBER}/temp/target/jmeter/results/
                        else
                            echo "No CSV files found to copy."
                        fi
                    '''

                    perfReport 'target/jmeter/results/*.csv'
                    sh 'echo ===============Finishing Performance Test Results======================='
                }
            }
        }

        stage('Erase JMeter Slaves') {
            steps {
                container('kubehelm') {
                    sh 'echo ==============Start JMeter result backup Process ========================'
                    sh 'pwd'
                    sh '''
                        for pod in $(kubectl get pod -l app.kubernetes.io/instance=distributed-jmeter-slave-${JOBNAME}-${BUILD_NUMBER} -o custom-columns=:metadata.name); do
                            kubectl cp $pod:/opt/perf-test-data/ /opt/results/jenkins/${JOB_NAME}/${BUILD_NUMBER}/$pod/
                        done
                        for pod in $(kubectl get pod -l app.kubernetes.io/component=jenkins-controller -o custom-columns=:metadata.name); do
                            kubectl cp $pod:/var/jenkins_home/jobs/${JOB_NAME}/builds/${BUILD_NUMBER}/performance-reports/JMeterCSV/ /opt/results/jenkins/${JOB_NAME}/${BUILD_NUMBER}/
                        done
                    '''
                    sh 'echo ==============Finished JMeter result backup Process ========================'

                    // sh 'sleep 10m'    // Add a sleep, In case want to backup some files from Jenkins slave workspace machines after test completion

                    sh 'echo ==============Start Erasing JMeter Slaves========================'
                    sh '''
                        helm uninstall distributed-jmeter-slave-${JOBNAME}-${BUILD_NUMBER}
                        kubectl wait --for=delete pods -l app.kubernetes.io/instance=distributed-jmeter-slave-${JOBNAME}-${BUILD_NUMBER} --timeout=90s
                    '''
                    sh 'echo ===============Finishing Erasing JMeter Slaves======================='
                }
            }
        }
    }

    post {
        unsuccessful {
            sh 'echo ==============Start post failure clearing =============='
            container('kubehelm') {
                sh '''
                    helm uninstall distributed-jmeter-slave-${JOBNAME}-${BUILD_NUMBER}
                    kubectl wait --for=delete pods -l app.kubernetes.io/instance=distributed-jmeter-slave-${JOBNAME}-${BUILD_NUMBER} --timeout=90s
                '''
            }
            sh 'echo ==============Finishing post failure clearing=============='
        }
    }
}
