&lt;styleSheet xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot; xmlns:vt=&quot;http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes&quot;&gt;&lt;numFmts count=&quot;1&quot;&gt;&lt;numFmt numFmtId=&quot;56&quot; formatCode=&quot;&amp;quot;上午/下午 &amp;quot;hh&amp;quot;時&amp;quot;mm&amp;quot;分&amp;quot;ss&amp;quot;秒 &amp;quot;&quot;/&gt;&lt;/numFmts&gt;&lt;fonts count=&quot;1&quot;&gt;&lt;font&gt;&lt;sz val=&quot;12&quot;/&gt;&lt;color theme=&quot;1&quot;/&gt;&lt;name val=&quot;Calibri&quot;/&gt;&lt;family val=&quot;2&quot;/&gt;&lt;scheme val=&quot;minor&quot;/&gt;&lt;/font&gt;&lt;/fonts&gt;&lt;fills count=&quot;2&quot;&gt;&lt;fill&gt;&lt;patternFill patternType=&quot;none&quot;/&gt;&lt;/fill&gt;&lt;fill&gt;&lt;patternFill patternType=&quot;gray125&quot;/&gt;&lt;/fill&gt;&lt;/fills&gt;&lt;borders count=&quot;1&quot;&gt;&lt;border&gt;&lt;left/&gt;&lt;right/&gt;&lt;top/&gt;&lt;bottom/&gt;&lt;diagonal/&gt;&lt;/border&gt;&lt;/borders&gt;&lt;cellStyleXfs count=&quot;1&quot;&gt;&lt;xf numFmtId=&quot;0&quot; fontId=&quot;0&quot; fillId=&quot;0&quot; borderId=&quot;0&quot;/&gt;&lt;/cellStyleXfs&gt;&lt;cellXfs count=&quot;1&quot;&gt;&lt;xf numFmtId=&quot;0&quot; fontId=&quot;0&quot; fillId=&quot;0&quot; borderId=&quot;0&quot; xfId=&quot;0&quot; applyNumberFormat=&quot;1&quot;/&gt;&lt;/cellXfs&gt;&lt;cellStyles count=&quot;1&quot;&gt;&lt;cellStyle name=&quot;Normal&quot; xfId=&quot;0&quot; builtinId=&quot;0&quot;/&gt;&lt;/cellStyles&gt;&lt;dxfs count=&quot;0&quot;/&gt;&lt;tableStyles count=&quot;0&quot; defaultTableStyle=&quot;TableStyleMedium9&quot; defaultPivotStyle=&quot;PivotStyleMedium4&quot;/&gt;&lt;/styleSheet&gt;PK&#x3;&#x4;&#x14;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;&#x0;��̱*/&#x0;&#x0;*/&#x0;&#x0;&#x18;&#x0;&#x0;&#x0;xl/worksheets/sheet1.xml&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?&gt;&#xd;
&lt;worksheet xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot; xmlns:r=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships&quot;&gt;&lt;dimension ref=&quot;A1:C70&quot;/&gt;&lt;sheetViews&gt;&lt;sheetView workbookViewId=&quot;0&quot;/&gt;&lt;/sheetViews&gt;&lt;cols&gt;&lt;col min=&quot;1&quot; max=&quot;1&quot; width=&quot;60.83203125&quot; customWidth=&quot;1&quot;/&gt;&lt;col min=&quot;2&quot; max=&quot;2&quot; width=&quot;50.83203125&quot; customWidth=&quot;1&quot;/&gt;&lt;col min=&quot;3&quot; max=&quot;3&quot; width=&quot;40.83203125&quot; customWidth=&quot;1&quot;/&gt;&lt;/cols&gt;&lt;sheetData&gt;&lt;row r=&quot;1&quot;&gt;&lt;c r=&quot;A1&quot; t=&quot;str&quot;&gt;&lt;v&gt;Supplier to fill in the details in Yellow Highlighted sections of Column C.  &amp;apos;TEXT&amp;apos; means free typing and &amp;apos;List of values&amp;apos; means use the drop down selections&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B1&quot; t=&quot;str&quot;&gt;&lt;v&gt;&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C1&quot; t=&quot;str&quot;&gt;&lt;v&gt;&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;2&quot;&gt;&lt;c r=&quot;A2&quot; t=&quot;str&quot;&gt;&lt;v&gt;REQUIRED MATERIAL DATA FIELD IN STIBO STEP&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B2&quot; t=&quot;str&quot;&gt;&lt;v&gt;ITEM FIELD TYPE DEFINED&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C2&quot; t=&quot;str&quot;&gt;&lt;v&gt;&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;3&quot;&gt;&lt;c r=&quot;A3&quot; t=&quot;str&quot;&gt;&lt;v&gt;In order for the Sysco Operating Company to get the item set up and on a Purchase Order, the Supplier must provide information for the Item data fields highlighted in yellow.&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B3&quot; t=&quot;str&quot;&gt;&lt;v&gt;Defines the type of item field/attribute for the supplier to populate in column C&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C3&quot; t=&quot;str&quot;&gt;&lt;v&gt;&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;4&quot;&gt;&lt;c r=&quot;A4&quot; t=&quot;str&quot;&gt;&lt;v&gt;INITIAL DATA&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B4&quot; t=&quot;str&quot;&gt;&lt;v&gt;TAB&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C4&quot; t=&quot;str&quot;&gt;&lt;v&gt;&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;5&quot;&gt;&lt;c r=&quot;A5&quot; t=&quot;str&quot;&gt;&lt;v&gt;*MATERIAL DESCRIPTION&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B5&quot; t=&quot;str&quot;&gt;&lt;v&gt;Text; 30 character field length restriction - Sysco will edit for content&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C5&quot; t=&quot;str&quot;&gt;&lt;v&gt;TOMATO ROMA&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;6&quot;&gt;&lt;c r=&quot;A6&quot; t=&quot;str&quot;&gt;&lt;v&gt;*MATERIAL UNABBREVIATED DESCRIPTION&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B6&quot; t=&quot;str&quot;&gt;&lt;v&gt;Text; unlimited length (Describe the product with specie, origin, skin on/off, size of portion, and pack style IQF/Vacuum pack/etc.&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C6&quot; t=&quot;str&quot;&gt;&lt;v&gt;TOMATO ROMA&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;7&quot;&gt;&lt;c r=&quot;A7&quot; t=&quot;str&quot;&gt;&lt;v&gt;*PRODUCT SPEC SHEET&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B7&quot; t=&quot;str&quot;&gt;&lt;v&gt;Attachment; Requester to load before submitting the request&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C7&quot; t=&quot;str&quot;&gt;&lt;v&gt;&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;8&quot;&gt;&lt;c r=&quot;A8&quot; t=&quot;str&quot;&gt;&lt;v&gt;*PACK&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B8&quot; t=&quot;str&quot;&gt;&lt;v&gt;Text; if the pack is greater than 1, must populate the Units for the Alternate Unit of Measure (How many packages in the master case?)&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C8&quot; t=&quot;str&quot;&gt;&lt;v&gt;4&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;9&quot;&gt;&lt;c r=&quot;A9&quot; t=&quot;str&quot;&gt;&lt;v&gt;*SIZE&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B9&quot; t=&quot;str&quot;&gt;&lt;v&gt;Text field: this is case count related to the PACK/SIZE referring to either the bulk pounds or interior alternate package/unit in ounces, pounds, or count&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C9&quot; t=&quot;str&quot;&gt;&lt;v&gt;4&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;10&quot;&gt;&lt;c r=&quot;A10&quot; t=&quot;str&quot;&gt;&lt;v&gt;*SIZE UOM&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B10&quot; t=&quot;str&quot;&gt;&lt;v&gt;List of Values&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C10&quot; t=&quot;str&quot;&gt;&lt;v&gt;BOTTLE&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;11&quot;&gt;&lt;c r=&quot;A11&quot; t=&quot;str&quot;&gt;&lt;v&gt;*CATCH WEIGHT&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B11&quot; t=&quot;str&quot;&gt;&lt;v&gt;Y/N&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C11&quot; t=&quot;str&quot;&gt;&lt;v&gt;Yes&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;12&quot;&gt;&lt;c r=&quot;A12&quot; t=&quot;str&quot;&gt;&lt;v&gt;*CONTAINER REQUIREMENTS&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B12&quot; t=&quot;str&quot;&gt;&lt;v&gt;List of Values&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C12&quot; t=&quot;str&quot;&gt;&lt;v&gt;CASE&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;13&quot;&gt;&lt;c r=&quot;A13&quot; t=&quot;str&quot;&gt;&lt;v&gt;*BRAND NAME&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B13&quot; t=&quot;str&quot;&gt;&lt;v&gt;Text&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C13&quot; t=&quot;str&quot;&gt;&lt;v&gt;BELLISSIMO&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;14&quot;&gt;&lt;c r=&quot;A14&quot; t=&quot;str&quot;&gt;&lt;v&gt;CORPORATE PROPRIETARY&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B14&quot; t=&quot;str&quot;&gt;&lt;v&gt;Defaults based on Brand&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C14&quot; t=&quot;str&quot;&gt;&lt;v&gt;&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;15&quot;&gt;&lt;c r=&quot;A15&quot; t=&quot;str&quot;&gt;&lt;v&gt;*MANUFACTURER PRODUCT CODE&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;B15&quot; t=&quot;str&quot;&gt;&lt;v&gt;Text&lt;/v&gt;&lt;/c&gt;&lt;c r=&quot;C15&quot; t=&quot;str&quot;&gt;&lt;v&gt;mpc001002888&lt;/v&gt;&lt;/c&gt;&lt;/row&gt;&lt;row r=&quot;16&quot;&gt;&lt;c r=&quot;A16&quot; t=&quo