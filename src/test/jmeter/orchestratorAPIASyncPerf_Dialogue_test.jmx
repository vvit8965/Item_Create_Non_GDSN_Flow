          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Thread-local CSV Loader" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
// Only load CSV into thread-local variable once per thread
if (vars.getObject(&apos;promptList&apos;) == null) {
    def prompts = []
    def csvFile = new File(&apos;src/test/testdata/userQueryData_contextualQ.csv&apos;)
    csvFile.withReader { reader -&gt;
        def isFirst = true
        reader.eachLine { line -&gt;
            if (isFirst) { isFirst = false; return } // skip header
            prompts &lt;&lt; line.trim()
        }
    }
    vars.putObject(&apos;promptList&apos;, prompts)
    vars.put(&apos;promptIndex&apos;, &apos;0&apos;)
}
</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Session ID Generator" enabled="true">
            <stringProp name="script">if (vars.get(&apos;rowCounter&apos;) == &apos;1&apos; || vars.get(&apos;session_id&apos;) == null) {
    vars.put(&apos;session_id&apos;, java.util.UUID.randomUUID().toString())
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Loop 3 Prompts per Session">
            <boolProp name="LoopController.continue_forever">false</boolProp>
            <intProp name="LoopController.loops">-1</intProp>
          </LoopController>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Set Prompt from Thread-local List" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">
def prompts = vars.getObject(&apos;promptList&apos;)
if (prompts == null || prompts.size() == 0) {
    throw new IllegalStateException(&apos;promptList is not initialized or empty!&apos;)
}
def idx = (vars.get(&apos;promptIndex&apos;) ?: &apos;0&apos;) as int
vars.put(&apos;prompt&apos;, prompts[idx])
// increment and wrap
idx = (idx + 1) % prompts.size()
vars.put(&apos;promptIndex&apos;, idx.toString())
</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
            </JSR223PreProcessor>
