        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="UserID Generator" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">// Generate session_id and user_id once per thread (session)
// DISABLED: session_id should be generated per CSV cycle, not per thread
if (!vars.get(&apos;user_id&apos;)) {
    vars.put(&apos;user_id&apos;, &apos;perfuser-&apos; + java.util.UUID.randomUUID().toString())
}
log.info(&quot;user_id=${vars.get(&apos;user_id&apos;)}&quot;)
</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
