              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Write Request Params to CSV" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="script">
import java.text.SimpleDateFormat
import java.util.Date

def csvFile = &quot;src/test/testdata/async_request_log_dialogue.csv&quot;
def userId = vars.get(&quot;user_id&quot;) ?: &quot;unknown_user&quot;
def sessionId = vars.get(&quot;session_id&quot;) ?: &quot;unknown_session&quot;
def requestId = vars.get(&quot;request_id&quot;) ?: &quot;unknown_request&quot;
def query = vars.get(&quot;prompt&quot;) ?: &quot;unknown_query&quot;
def response = prev.getResponseDataAsString() ?: &quot;no_response&quot;
def timestamp = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())

def header = &quot;user_id,session_id,timestamp,request_id,query,response\n&quot;
def line = &quot;${userId},${sessionId},${timestamp},${requestId},\&quot;${query}\&quot;,\&quot;${response}\&quot;\n&quot;

def file = new File(csvFile)
if (!file.parentFile.exists()) {
    file.parentFile.mkdirs()
}
if (!file.exists() || file.length() == 0) {
    file.createNewFile()
    file.append(header)
}
file.append(line)
              </stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
              </JSR223PostProcessor>
